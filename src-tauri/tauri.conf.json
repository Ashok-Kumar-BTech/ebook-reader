{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ebook Reader",
  "version": "1.0.0",
  "identifier": "com.ebook.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ebook Reader",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Viewer"
      },
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB Ebook",
        "description": "Electronic Publication Ebook",
        "role": "Viewer"
      },
      {
        "ext": [
          "cbz",
          "cbr"
        ],
        "name": "Comic Book Archive",
        "description": "Comic Book Archive File",
        "role": "Viewer"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text Document",
        "description": "Plain Text Document",
        "role": "Viewer"
      },
      {
        "ext": [
          "html",
          "htm",
          "xhtml"
        ],
        "name": "HTML Document",
        "description": "HyperText Markup Language Document",
        "role": "Viewer"
      },
      {
        "ext": [
          "docx"
        ],
        "name": "Microsoft Word Document",
        "description": "Office Open XML Document",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {}
}
